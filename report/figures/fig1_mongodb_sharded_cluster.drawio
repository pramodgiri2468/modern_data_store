  <diagram id="diag_mongo_cluster" name="Figure 1 - MongoDB Sharded Cluster">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Box -->
        <mxCell id="title" value="&lt;b&gt;Distributed MongoDB Sharded Cluster Architecture (Scale-Out &amp; High Availability)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#144178;strokeColor=#0D2B52;fontColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="920" height="40" as="geometry" />
        </mxCell>

        <!-- Tier 1: Client Application Tier -->
