        <mxCell id="mongos_1_1" value="&lt;b&gt;mongos Router 1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#234E52&quot;&gt;Port: 27017 (Stateless)&lt;br&gt;Caches Routing Table&lt;br&gt;Query Split &amp; Result Merge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#319795;fontColor=#234E52;fontSize=10;" vertex="1" parent="1">
