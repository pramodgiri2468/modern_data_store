    <Array as="points">
      <mxPoint x="910" y="385" />
    </Array>
  </mxGeometry>
</mxCell>

<!-- 4. Closing -> Fully Closed -->
<mxCell id="tr_c_fc" value="Limit Switch:&#xa;FULLY_CLOSED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F855A;strokeWidth=2;fontColor=#22543D;fontSize=10;" edge="1" parent="1" source="st_closing" target="st_closed">
  <mxGeometry relative="1" as="geometry">
    <Array as="points">
      <mxPoint x="250" y="385" />
    </Array>
  </mxGeometry>
</mxCell>

<!-- 5. CRITICAL SAFETY REVERSE (Closing -> Opening) -->
<mxCell id="tr_safety" value="&lt;b&gt;EMERGENCY SAFETY INTERLOCK (BS EN 12453)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Photocell Beam BLOCKED &gt; 50ms&lt;/b&gt;&lt;br&gt;Immediate Motor Reverse Triggered in &lt;b&gt;&amp;lt; 7.4ms&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C53030;strokeWidth=3.5;fontColor=#C53030;fontSize=10;dashed=0;" edge="1" parent="1" source="st_closing" target="st_opening">
  <mxGeometry relative="1" as="geometry" />
</mxCell>

<!-- Safety Standard Callout -->
<mxCell id="callout" value="&lt;b&gt;SAFETY COMPLIANCE NOTE:&lt;/b&gt; In accordance with &lt;b&gt;BS EN 12453:2017&lt;/b&gt;, closing motorized gates must eliminate crush hazards. The Node.js controller intercepts the MQTT safety topic and bypasses database queueing to issue the reverse command within 7.4ms." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#FEB2B2;fontColor=#9B2C2C;fontSize=10;align=center;" vertex="1" parent="1">
  <mxGeometry x="140" y="470" width="880" height="50" as="geometry" />
</mxCell>
