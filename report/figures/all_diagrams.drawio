      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
<!-- Title Box -->
<mxCell id="title" value="&lt;b&gt;Data Modeling Paradigm: Relational 3NF Schema vs. MongoDB Embedded Document Model&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#2A4365;fontColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1">
  <mxGeometry x="140" y="20" width="880" height="40" as="geometry" />
</mxCell>

<!-- Left Container: Relational 3NF -->
<mxCell id="c_rel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#FEB2B2;dashed=1;" vertex="1" parent="1">
  <mxGeometry x="140" y="80" width="420" height="460" as="geometry" />
</mxCell>
<mxCell id="lbl_rel" value="&lt;b&gt;RELATIONAL 3NF SCHEMA (POSTGRESQL)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9B2C2C&quot;&gt;Normalized Tables • Multi-Table SQL JOINs • Schema-on-Write&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#9B2C2C;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="150" y="90" width="400" height="30" as="geometry" />
</mxCell>

<mxCell id="t_homes" value="&lt;b&gt;gate_homes&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; home_id : VARCHAR(32)&lt;br&gt;owner_name : VARCHAR(128)&lt;br&gt;address_postcode : VARCHAR(16)&lt;br&gt;created_at : TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E53E3E;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
  <mxGeometry x="160" y="130" width="220" height="80" as="geometry" />
</mxCell>

<mxCell id="t_devices" value="&lt;b&gt;gate_devices&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; device_id : VARCHAR(32)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; home_id : VARCHAR(32)&lt;br&gt;device_type : VARCHAR(64)&lt;br&gt;firmware_version : VARCHAR(16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E53E3E;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
  <mxGeometry x="160" y="240" width="220" height="80" as="geometry" />
</mxCell>

<mxCell id="t_telemetry" value="&lt;b&gt;gate_telemetry_events&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; event_id : BIGSERIAL&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; device_id : VARCHAR(32)&lt;br&gt;timestamp : TIMESTAMP&lt;br&gt;photocell_status : VARCHAR(16)&lt;br&gt;limit_switch : VARCHAR(16)&lt;br&gt;motor_current_amps : NUMERIC(4,2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E53E3E;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
  <mxGeometry x="160" y="350" width="220" height="105" as="geometry" />
</mxCell>

<mxCell id="e_fk1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E53E3E;strokeWidth=1.5;fontColor=#9B2C2C;fontSize=10;" edge="1" parent="1" source="t_homes" target="t_devices">
  <mxGeometry relative="1" as="geometry" />
</mxCell>
<mxCell id="e_fk2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E53E3E;strokeWidth=1.5;fontColor=#9B2C2C;fontSize=10;" edge="1" parent="1" source="t_devices" target="t_telemetry">
  <mxGeometry relative="1" as="geometry" />
</mxCell>

<mxCell id="rel_drawbacks" value="&lt;b&gt;Bottlenecks:&lt;/b&gt; Requires 3-table SQL JOIN to read state; DDL schema lock on new sensor; multiple random disk seeks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FED7D7;strokeColor=#FEB2B2;fontColor=#742A2A;fontSize=9;align=center;" vertex="1" parent="1">
  <mxGeometry x="160" y="470" width="380" height="50" as="geometry" />
</mxCell>

<!-- Right Container: MongoDB Document -->
<mxCell id="c_mongo" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#9AE6B4;dashed=1;" vertex="1" parent="1">
  <mxGeometry x="600" y="80" width="420" height="460" as="geometry" />
</mxCell>
<mxCell id="lbl_mongo" value="&lt;b&gt;MONGODB EMBEDDED DOCUMENT MODEL&lt;/b&gt;&lt;br&gt;&lt;font color=#22543D&gt;Pre-Aggregated BSON Tree • Single Disk Seek • Zero JOINs&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#22543D;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="610" y="90" width="400" height="30" as="geometry" />
</mxCell>

<mxCell id="doc_json" value="&lt;b&gt;Collection: gate_telemetries&lt;/b&gt;&lt;hr&gt;{&#xa;  &quot;_id&quot;: ObjectId(&quot;6709a1f2b4...&quot;),&#xa;  &quot;homeId&quot;: &quot;HOME_UK_001&quot;,&#xa;  &quot;timestamp&quot;: ISODate(&quot;2026-10-02T08:14:22Z&quot;),&#xa;  &quot;gateState&quot;: &quot;CLOSING&quot;,&#xa;  &quot;sensors&quot;: {&#xa;    &quot;photocell&quot;: { &quot;status&quot;: &quot;CLEAR&quot;, &quot;beamStrength&quot;: 98.4 },&#xa;    &quot;limitSwitch&quot;: { &quot;state&quot;: &quot;AJAR&quot;, &quot;angleDeg&quot;: 34.2 },&#xa;    &quot;rfid&quot;: { &quot;lastScannedBadge&quot;: &quot;TAG_AUTH_8831&quot; }&#xa;  },&#xa;  &quot;metrics&quot;: {&#xa;    &quot;motorCurrentAmps&quot;: 4.12,&#xa;    &quot;batteryVoltage&quot;: 13.8&#xa;  }&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F855A;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
  <mxGeometry x="620" y="130" width="380" height="320" as="geometry" />
</mxCell>

<mxCell id="mongo_advantages" value="&lt;b&gt;Advantages:&lt;/b&gt; Zero JOINs; fetched in 1 contiguous disk seek (2.75ms); dynamic schema polymorphism; native JSON mapping." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6F6D5;strokeColor=#9AE6B4;fontColor=#22543D;fontSize=9;align=center;" vertex="1" parent="1">
  <mxGeometry x="620" y="470" width="380" height="50" as="geometry" />
</mxCell>
</root>
    </mxGraphModel>
  </diagram>
