<mxCell id="b4" value="&lt;b&gt;12.61 ms&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;verticalAlign=bottom;fontSize=10;spacingBottom=4;" vertex="1" parent="1">
