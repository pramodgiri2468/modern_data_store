</mxCell>
<mxCell id="lbl_b5" value="&lt;b&gt;PUT Update&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#718096&quot;&gt;In-Place BSON&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
  <mxGeometry x="745" y="420" width="100" height="40" as="geometry" />
</mxCell>

