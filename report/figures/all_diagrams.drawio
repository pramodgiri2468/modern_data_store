<!-- Title Box -->
<mxCell id="title" value="&lt;b&gt;MongoDB 3-Node Replica Set Topology &amp; Quorum Consensus (rs0)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#2A4365;fontColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1">
  <mxGeometry x="180" y="20" width="800" height="40" as="geometry" />
</mxCell>

<!-- Primary Node -->
<mxCell id="n1" value="&lt;b&gt;NODE 1: PRIMARY&lt;/b&gt;&lt;br&gt;&lt;b&gt;127.0.0.1:27017&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Priority: 2 | Voting Shares: 1&lt;br&gt;Data Path: /data/db1&lt;br&gt;Directs Client Read/Writes&lt;br&gt;Appends to local.oplog.rs&lt;br&gt;WiredTiger Cache: 1.5 GB&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="460" y="90" width="240" height="150" as="geometry" />
</mxCell>

<!-- Secondary Node 1 -->
<mxCell id="n2" value="&lt;b&gt;NODE 2: SECONDARY&lt;/b&gt;&lt;br&gt;&lt;b&gt;127.0.0.1:27018&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7B341E&quot;&gt;Priority: 1 | Voting Shares: 1&lt;br&gt;Data Path: /data/db2&lt;br&gt;Tails Primary local.oplog.rs&lt;br&gt;Dynamic Ping Sync Source&lt;br&gt;Eligible for Primary Election&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="220" y="320" width="240" height="150" as="geometry" />
</mxCell>

<!-- Secondary Node 2 -->
<mxCell id="n3" value="&lt;b&gt;NODE 3: SECONDARY&lt;/b&gt;&lt;br&gt;&lt;b&gt;127.0.0.1:27019&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7B341E&quot;&gt;Priority: 1 | Voting Shares: 1&lt;br&gt;Data Path: /data/db3&lt;br&gt;Tails Primary local.oplog.rs&lt;br&gt;Dynamic Ping Sync Source&lt;br&gt;Quorum Voter Member&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="700" y="320" width="240" height="150" as="geometry" />
</mxCell>

<!-- Heartbeat & Sync Connectors -->
<mxCell id="e_hb12" value="2000ms Heartbeats&#xa;&amp; Oplog Replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F855A;strokeWidth=2;fontColor=#22543D;fontSize=10;" edge="1" parent="1" source="n1" target="n2">
