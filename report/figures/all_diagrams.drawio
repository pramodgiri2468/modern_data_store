        <mxCell id="box_shards_1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#CBD5E0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="920" height="230" as="geometry" />
        </mxCell>
        <mxCell id="lbl_shard_1" value="&lt;b&gt;HORIZONTAL PERSISTENCE TIER — AUTONOMOUS SHARD REPLICA SETS&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#4A5568;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="135" y="405" width="450" height="20" as="geometry" />
        </mxCell>
        <mxCell id="shard1_box_1" value="&lt;b&gt;SHARD 1 (rs-shard1)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Chunk Range: [MinKey, &quot;HOME_UK_033&quot;)&lt;br&gt;&lt;b&gt;Primary:&lt;/b&gt; :27117 (Priority: 2)&lt;br&gt;&lt;b&gt;Secondaries:&lt;/b&gt; :27118, :27119&lt;br&gt;2s Heartbeats | local.oplog.rs&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="445" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="shard2_box_1" value="&lt;b&gt;SHARD 2 (rs-shard2)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Chunk Range: [&quot;HOME_UK_033&quot;, &quot;HOME_UK_066&quot;)&lt;br&gt;&lt;b&gt;Primary:&lt;/b&gt; :27217 (Priority: 2)&lt;br&gt;&lt;b&gt;Secondaries:&lt;/b&gt; :27218, :27219&lt;br&gt;2s Heartbeats | local.oplog.rs&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="455" y="445" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="shard3_box_1" value="&lt;b&gt;SHARD 3 (rs-shard3)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Chunk Range: [&quot;HOME_UK_066&quot;, MaxKey)&lt;br&gt;&lt;b&gt;Primary:&lt;/b&gt; :27317 (Priority: 2)&lt;br&gt;&lt;b&gt;Secondaries:&lt;/b&gt; :27318, :27319&lt;br&gt;2s Heartbeats | local.oplog.rs&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="445" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e_m1_s1_1" value="Targeted Route (homeId)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2B6CB0;strokeWidth=1.5;fontColor=#2C5282;fontSize=9;" edge="1" parent="1" source="mongos_1_1" target="shard1_box_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_m1_s2_1" value="Scatter / Gather" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2B6CB0;strokeWidth=1.5;fontColor=#2C5282;fontSize=9;" edge="1" parent="1" source="mongos_1_1" target="shard2_box_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_m2_s3_1" value="Targeted Route (homeId)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2B6CB0;strokeWidth=1.5;fontColor=#2C5282;fontSize=9;" edge="1" parent="1" source="mongos_2_1" target="shard3_box_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="summary_1" value="&lt;b&gt;DISTRIBUTED SHARDING KEY PRINCIPLES:&lt;/b&gt; Sharding Key: &lt;b&gt;{ homeId: 1 }&lt;/b&gt; ensures 100% of telemetry writes and recent status lookups for a given residential gate route directly to a single shard without cross-node network penalty. Mongos query routers provide seamless horizontal scale-out while autonomous 3-node replica sets on every shard ensure automatic failover (&amp;lt; 2s) with zero data loss." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2C5282;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="650" width="920" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- TAB 2: FIGURE 2 - CASSANDRA MASTERLESS TOKEN RING -->
  <diagram id="diag_cassandra_ring" name="Fig 2 - Cassandra Token Ring">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_2" value="&lt;b&gt;Apache Cassandra Masterless Peer-to-Peer Token Ring Network Topology&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#144178;strokeColor=#0D2B52;fontColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="940" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ring_guide_2" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#CBD5E0;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="140" width="460" height="460" as="geometry" />
        </mxCell>
        <mxCell id="center_hub_2" value="&lt;b&gt;CONSISTENT HASHING RING&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;&lt;b&gt;Murmur3Partitioner&lt;/b&gt;&lt;br&gt;Token Range: [-2&lt;sup&gt;63&lt;/sup&gt; to 2&lt;sup&gt;63&lt;/sup&gt; - 1]&lt;br&gt;&lt;hr&gt;&lt;b&gt;Gossip Protocol:&lt;/b&gt; 1s Heartbeat Mesh&lt;br&gt;&lt;b&gt;Failure Detector:&lt;/b&gt; &amp;Phi;-Accrual Metric&lt;br&gt;&lt;b&gt;Replication Factor:&lt;/b&gt; RF = 3 (Multi-Rack)&lt;br&gt;&lt;b&gt;Consistency:&lt;/b&gt; QUORUM = &amp;lfloor;3/2&amp;rfloor; + 1 = 2&lt;/font&gt;" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#2B6CB0;strokeWidth=2;fontColor=#1A365D;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="495" y="255" width="230" height="230" as="geometry" />
        </mxCell>
        <mxCell id="node1_2" value="&lt;b&gt;NODE 1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Rack 1A | 10.0.1.11&lt;br&gt;&lt;b&gt;Token:&lt;/b&gt; 0x0000 0000&lt;br&gt;Primary Replica A&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="80" width="130" height="100" as="geometry" />
        </mxCell>
        <mxCell id="node2_2" value="&lt;b&gt;NODE 2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Rack 1B | 10.0.1.12&lt;br&gt;&lt;b&gt;Token:&lt;/b&gt; 0x2AAA AAAA&lt;br&gt;Replica Copy B&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="770" y="200" width="130" height="100" as="geometry" />
        </mxCell>
        <mxCell id="node3_2" value="&lt;b&gt;NODE 3&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Rack 2A | 10.0.1.13&lt;br&gt;&lt;b&gt;Token:&lt;/b&gt; 0x5555 5555&lt;br&gt;Replica Copy C&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="770" y="440" width="130" height="100" as="geometry" />
        </mxCell>
        <mxCell id="node4_2" value="&lt;b&gt;NODE 4&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;Rack 2B | 10.0.1.14&lt;br&gt;&lt;b&gt;Token:&lt;/b&gt; 0x8000 0000&lt;br&gt;Symmetric Peer&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2C5282;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="560" width="130" height="100" as="geometry" />
        </mxCell>
        <mxCell id="node5_2" value="&lt;b&gt;NODE 5&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;Rack 3A | 10.0.1.15&lt;br&gt;&lt;b&gt;Token:&lt;/b&gt; 0xAAAA AAAA&lt;br&gt;Symmetric Peer&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2C5282;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="440" width="130" height="100" as="geometry" />
        </mxCell>
        <mxCell id="node6_2" value="&lt;b&gt;NODE 6 (COORDINATOR)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7B341E&quot;&gt;Rack 3B | 10.0.1.16&lt;br&gt;&lt;b&gt;Token:&lt;/b&gt; 0xD555 5555&lt;br&gt;Receives Client Request&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="200" width="145" height="100" as="geometry" />
        </mxCell>
        <mxCell id="client_cql_2" value="&lt;b&gt;IoThings Ingestion Client&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5568&quot;&gt;CQL Native Driver&lt;br&gt;Key: &lt;b&gt;homeId = 'HOME_UK_001'&lt;/b&gt;&lt;br&gt;ConsistencyLevel: &lt;b&gt;QUORUM&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#6B46C1;fontColor=#44337A;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="210" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e_client_coord_2" value="CQL Write Request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6B46C1;strokeWidth=2;fontColor=#44337A;fontSize=9;" edge="1" parent="1" source="client_cql_2" target="node6_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_coord_rep1_2" value="Replica Write 1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DD6B20;strokeWidth=1.8;fontColor=#7B341E;fontSize=9;" edge="1" parent="1" source="node6_2" target="node1_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_coord_rep2_2" value="Replica Write 2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DD6B20;strokeWidth=1.8;fontColor=#7B341E;fontSize=9;" edge="1" parent="1" source="node6_2" target="node2_2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="480" y="190" />
              <mxPoint x="750" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_coord_rep3_2" value="Replica Write 3 (RF=3)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DD6B20;strokeWidth=1.8;fontColor=#7B341E;fontSize=9;" edge="1" parent="1" source="node6_2" target="node3_2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="380" />
              <mxPoint x="740" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="callout_2" value="&lt;b&gt;CASSANDRA MASTERLESS PRINCIPLES:&lt;/b&gt; Symmetrical peer-to-peer ring eliminates master bottlenecks and Single Points of Failure (SPOF). Client can connect to &lt;b&gt;any arbitrary node&lt;/b&gt;, which acts as Coordinator for the transaction. The coordinator uses the Murmur3 hash of the partition key to forward writes to exactly RF=3 replica nodes. Strong consistency is satisfied because &lt;b&gt;R (2) + W (2) &amp;gt; RF (3)&lt;/b&gt;, guaranteeing read-your-writes consistency across network partitions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2C5282;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="690" width="940" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- TAB 3: FIGURE 3 - NEO4J CAUSAL CLUSTERING -->
  <diagram id="diag_neo4j_cluster" name="Fig 3 - Neo4j Causal Clustering">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_3" value="&lt;b&gt;Neo4j High Availability &amp; Causal Clustering Architecture (Core Raft &amp; Scale-Out Read Replicas)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#144178;strokeColor=#0D2B52;fontColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="940" height="40" as="geometry" />
        </mxCell>
        <mxCell id="box_client_3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#CBD5E0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="80" width="940" height="85" as="geometry" />
        </mxCell>
        <mxCell id="bolt_driver_3" value="&lt;b&gt;Neo4j Bolt Smart Routing Driver (bolt+routing://)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4A5568&quot;&gt;Directs Cypher Writes to Core Leader | Load-balances Reads to Followers &amp; Read Replicas&lt;br&gt;Maintains Causal Chaining via Transaction Bookmarks (Read-Your-Own-Writes Guarantee)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#6B46C1;fontColor=#44337A;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="220" y="110" width="740" height="45" as="geometry" />
        </mxCell>
        <mxCell id="box_core_3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#CBD5E0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="195" width="940" height="250" as="geometry" />
        </mxCell>
        <mxCell id="lbl_core_3" value="&lt;b&gt;CORE CLUSTER TIER (RAFT PROTOCOL CONSENSUS &amp; ACID GRAPH PERSISTENCE)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#4A5568;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="135" y="200" width="550" height="20" as="geometry" />
        </mxCell>
        <mxCell id="core_leader_3" value="&lt;b&gt;CORE LEADER (MASTER)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9B2C2C&quot;&gt;&lt;b&gt;Bolt: 7687 | HTTP: 7474&lt;/b&gt;&lt;br&gt;- Exclusive Coordinator for ACID Writes&lt;br&gt;- Appends to neostore.transaction.db&lt;br&gt;- Coordinates Raft Log Majority Quorum&lt;br&gt;- Index-Free Adjacency Graph Engine&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#9B2C2C;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="225" width="260" height="135" as="geometry" />
        </mxCell>
        <mxCell id="core_f1_3" value="&lt;b&gt;CORE FOLLOWER 1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;Port: 7688 | Raft Voting Member&lt;br&gt;- Replicates Raft Transaction Log&lt;br&gt;- Local Native Graph Store Copy&lt;br&gt;- Eligible for Immediate Leader Election&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2C5282;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="295" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="core_f2_3" value="&lt;b&gt;CORE FOLLOWER 2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;Port: 7689 | Raft Voting Member&lt;br&gt;- Replicates Raft Transaction Log&lt;br&gt;- Local Native Graph Store Copy&lt;br&gt;- Quorum Participant (Q = 2 of 3)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2C5282;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="780" y="295" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e_write_3" value="Cypher ACID Writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C53030;strokeWidth=2;fontColor=#9B2C2C;fontSize=9;" edge="1" parent="1" source="bolt_driver_3" target="core_leader_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_raft1_3" value="Raft Log Replication &amp; Pings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2B6CB0;strokeWidth=1.8;fontColor=#2C5282;fontSize=9;" edge="1" parent="1" source="core_leader_3" target="core_f1_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_raft2_3" value="Raft Log Replication &amp; Pings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2B6CB0;strokeWidth=1.8;fontColor=#2C5282;fontSize=9;" edge="1" parent="1" source="core_leader_3" target="core_f2_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="box_rr_3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#CBD5E0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="480" width="940" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lbl_rr_3" value="&lt;b&gt;READ REPLICA SCALE-OUT TIER (ASYNCHRONOUS TRANSACTION LOG SHIPPING)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#4A5568;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="135" y="485" width="580" height="20" as="geometry" />
        </mxCell>
        <mxCell id="rr_1_3" value="&lt;b&gt;READ REPLICA 1&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Port: 7690 (Non-Voting)&lt;br&gt;Scales Cypher Read Queries&lt;br&gt;Asynchronous Catch-Up&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="520" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="rr_2_3" value="&lt;b&gt;READ REPLICA 2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Port: 7691 (Non-Voting)&lt;br&gt;Graph Traversals &amp; Analytics&lt;br&gt;Path Finding Queries&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="520" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="rr_3_3" value="&lt;b&gt;READ REPLICA 3&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Port: 7692 (Non-Voting)&lt;br&gt;Security Audit Reports&lt;br&gt;External BI Dashboards&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="520" width="220" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e_ship1_3" value="Async Log Catch-Up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2F855A;strokeWidth=1.5;fontColor=#22543D;fontSize=9;" edge="1" parent="1" source="core_f1_3" target="rr_1_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ship2_3" value="Async Log Catch-Up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2F855A;strokeWidth=1.5;fontColor=#22543D;fontSize=9;" edge="1" parent="1" source="core_leader_3" target="rr_2_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ship3_3" value="Async Log Catch-Up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2F855A;strokeWidth=1.5;fontColor=#22543D;fontSize=9;" edge="1" parent="1" source="core_f2_3" target="rr_3_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="callout_3" value="&lt;b&gt;NEO4J CAUSAL CLUSTERING PRINCIPLES:&lt;/b&gt; Core cluster members participate in Raft consensus, ensuring graph modifications (nodes, relationships, indexes) satisfy strict ACID durability ($Q = \lfloor 3/2 \rfloor + 1 = 2$). Non-voting Read Replicas scale out arbitrary graph traversals without degrading write throughput. The Bolt driver uses causal bookmark tokens to guarantee read-your-own-writes across asynchronous read replicas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2C5282;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="685" width="940" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- TAB 4: FIGURE 4 - DATABASE SCHEMA RELATIONSHIPS -->
  <diagram id="diag_schema_rel" name="Fig 4 - Database Schema Relationships">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_4" value="&lt;b&gt;IoThings Multi-Collection Relational/Referential Schema &amp; Document Relationships&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#144178;strokeColor=#0D2B52;fontColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="980" height="40" as="geometry" />
        </mxCell>
        <mxCell id="col_gate_state_4" value="&lt;b&gt;gate_state&lt;/b&gt;&lt;hr&gt;&lt;b&gt;_id:&lt;/b&gt; ObjectId &lt;font color=&quot;#718096&quot;&gt;(PK)&lt;/font&gt;&lt;br&gt;&lt;b&gt;homeId:&lt;/b&gt; String &lt;font color=&quot;#2B6CB0&quot;&gt;[Unique Shard Key]&lt;/font&gt;&lt;br&gt;&lt;b&gt;gateId:&lt;/b&gt; String &lt;font color=&quot;#718096&quot;&gt;('GATE_01')&lt;/font&gt;&lt;br&gt;&lt;b&gt;currentStatus:&lt;/b&gt; String &lt;font color=&quot;#2F855A&quot;&gt;('CLOSED'|'OPENING'|'OPEN'|'CLOSING')&lt;/font&gt;&lt;br&gt;&lt;b&gt;lastAction:&lt;/b&gt; String &lt;font color=&quot;#718096&quot;&gt;('EMERGENCY_REVERSE'|'RFID_OPEN')&lt;/font&gt;&lt;br&gt;&lt;b&gt;motorCurrentAmps:&lt;/b&gt; Double &lt;font color=&quot;#718096&quot;&gt;(3.82 A)&lt;/font&gt;&lt;br&gt;&lt;b&gt;batteryVoltage:&lt;/b&gt; Double &lt;font color=&quot;#718096&quot;&gt;(13.6 V)&lt;/font&gt;&lt;br&gt;&lt;b&gt;updatedAt:&lt;/b&gt; ISODate &lt;font color=&quot;#718096&quot;&gt;(Last Heartbeat)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="90" width="280" height="150" as="geometry" />
        </mxCell>
        <mxCell id="col_telemetry_4" value="&lt;b&gt;telemetry_stream&lt;/b&gt; &lt;font color=&quot;#DD6B20&quot;&gt;&lt;b&gt;(TTL: 30 Days)&lt;/b&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;_id:&lt;/b&gt; ObjectId &lt;font color=&quot;#718096&quot;&gt;(PK)&lt;/font&gt;&lt;br&gt;&lt;b&gt;homeId:&lt;/b&gt; String &lt;font color=&quot;#2B6CB0&quot;&gt;[Parent Ref]&lt;/font&gt;&lt;br&gt;&lt;b&gt;timestamp:&lt;/b&gt; ISODate &lt;font color=&quot;#DD6B20&quot;&gt;[TTL Expire: 2,592,000s]&lt;/font&gt;&lt;br&gt;&lt;b&gt;photocell:&lt;/b&gt; {&lt;br&gt;&amp;nbsp;&amp;nbsp;status: String &lt;font color=&quot;#718096&quot;&gt;('CLEAR' | 'BLOCKED')&lt;/font&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;signalStrength: Double &lt;font color=&quot;#718096&quot;&gt;(98.4%)&lt;/font&gt;&lt;br&gt;}&lt;br&gt;&lt;b&gt;limitSwitch:&lt;/b&gt; {&lt;br&gt;&amp;nbsp;&amp;nbsp;state: String &lt;font color=&quot;#718096&quot;&gt;('CLOSED' | 'OPEN' | 'AJAR')&lt;/font&gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;contactClosed: Boolean&lt;br&gt;}&lt;br&gt;&lt;b&gt;motor:&lt;/b&gt; { currentDraw: Double, voltage: Double }&lt;br&gt;&lt;font color=&quot;#2F855A&quot;&gt;&lt;b&gt;Compound Index:&lt;/b&gt; { homeId: 1, timestamp: -1 }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="col_policies_4" value="&lt;b&gt;access_policies&lt;/b&gt;&lt;hr&gt;&lt;b&gt;_id:&lt;/b&gt; ObjectId &lt;font color=&quot;#718096&quot;&gt;(PK)&lt;/font&gt;&lt;br&gt;&lt;b&gt;badgeId:&lt;/b&gt; String &lt;font color=&quot;#6B46C1&quot;&gt;[Unique B-Tree Index]&lt;/font&gt;&lt;br&gt;&lt;b&gt;homeId:&lt;/b&gt; String &lt;font color=&quot;#2B6CB0&quot;&gt;[Parent Ref]&lt;/font&gt;&lt;br&gt;&lt;b&gt;holderName:&lt;/b&gt; String &lt;font color=&quot;#718096&quot;&gt;(Pseudonymized)&lt;/font&gt;&lt;br&gt;&lt;b&gt;role:&lt;/b&gt; String &lt;font color=&quot;#718096&quot;&gt;('RESIDENT'|'VISITOR'|'DELIVERY')&lt;/font&gt;&lt;br&gt;&lt;b&gt;allowedDays:&lt;/b&gt; Array&amp;lt;Int&amp;gt; &lt;font color=&quot;#718096&quot;&gt;([1, 2, 3, 4, 5])&lt;/font&gt;&lt;br&gt;&lt;b&gt;timeWindow:&lt;/b&gt; { start: &quot;08:00&quot;, end: &quot;20:00&quot; }&lt;br&gt;&lt;b&gt;enabled:&lt;/b&gt; Boolean &lt;font color=&quot;#718096&quot;&gt;(true)&lt;/font&gt;&lt;br&gt;&lt;b&gt;expiresAt:&lt;/b&gt; ISODate &lt;font color=&quot;#718096&quot;&gt;(Nullable)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#6B46C1;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="330" width="280" height="170" as="geometry" />
        </mxCell>
        <mxCell id="col_events_4" value="&lt;b&gt;access_events&lt;/b&gt; &lt;font color=&quot;#718096&quot;&gt;(Security Ingress Audit)&lt;/font&gt;&lt;hr&gt;&lt;b&gt;_id:&lt;/b&gt; ObjectId &lt;font color=&quot;#718096&quot;&gt;(PK)&lt;/font&gt;&lt;br&gt;&lt;b&gt;badgeId:&lt;/b&gt; String &lt;font color=&quot;#6B46C1&quot;&gt;[FK Index Reference]&lt;/font&gt;&lt;br&gt;&lt;b&gt;homeId:&lt;/b&gt; String &lt;font color=&quot;#2B6CB0&quot;&gt;[Parent Ref]&lt;/font&gt;&lt;br&gt;&lt;b&gt;gateId:&lt;/b&gt; String &lt;font color=&quot;#718096&quot;&gt;('GATE_01')&lt;/font&gt;&lt;br&gt;&lt;b&gt;timestamp:&lt;/b&gt; ISODate &lt;font color=&quot;#718096&quot;&gt;(Scanned Time)&lt;/font&gt;&lt;br&gt;&lt;b&gt;accessDecision:&lt;/b&gt; String &lt;font color=&quot;#2F855A&quot;&gt;('GRANTED'&lt;/font&gt; | &lt;font color=&quot;#C53030&quot;&gt;'DENIED')&lt;/font&gt;&lt;br&gt;&lt;b&gt;reasonCode:&lt;/b&gt; String &lt;font color=&quot;#718096&quot;&gt;('VALID_CREDENTIAL' | 'OUTSIDE_HOURS')&lt;/font&gt;&lt;br&gt;&lt;b&gt;scannedReader:&lt;/b&gt; String &lt;font color=&quot;#718096&quot;&gt;('RFID_ENTRY_D5')&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B46C1&quot;&gt;&lt;b&gt;Compound Index:&lt;/b&gt; { badgeId: 1, timestamp: -1 }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#E53E3E;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="325" width="380" height="175" as="geometry" />
        </mxCell>
        <mxCell id="col_alerts_4" value="&lt;b&gt;system_alerts&lt;/b&gt; &lt;font color=&quot;#C53030&quot;&gt;&lt;b&gt;(Critical Safety &amp; Intrusion Log)&lt;/b&gt;&lt;/font&gt;&lt;hr&gt;&lt;b&gt;_id:&lt;/b&gt; ObjectId (PK)&lt;br&gt;&lt;b&gt;homeId:&lt;/b&gt; String &lt;font color=&quot;#2B6CB0&quot;&gt;[Parent Ref]&lt;/font&gt; &amp;nbsp;|&amp;nbsp; &lt;b&gt;gateId:&lt;/b&gt; String&lt;br&gt;&lt;b&gt;alertType:&lt;/b&gt; String &lt;font color=&quot;#C53030&quot;&gt;('SAFETY_AUTO_REVERSE' | 'TAMPER_FORCE' | 'REPEATED_DENIED_RFID')&lt;/font&gt;&lt;br&gt;&lt;b&gt;severity:&lt;/b&gt; String &lt;font color=&quot;#C53030&quot;&gt;('CRITICAL' | 'WARNING')&lt;/font&gt;&lt;br&gt;&lt;b&gt;reactionTimeMs:&lt;/b&gt; Double &lt;font color=&quot;#22543D&quot;&gt;(7.4 ms &amp;lt; 8ms BS EN 12453)&lt;/font&gt;&lt;br&gt;&lt;b&gt;notifiedEmail:&lt;/b&gt; Boolean &lt;font color=&quot;#718096&quot;&gt;(Nodemailer SMTP dispatched to pg016742@gmail.com)&lt;/font&gt;&lt;br&gt;&lt;b&gt;timestamp:&lt;/b&gt; ISODate &lt;font color=&quot;#718096&quot;&gt;(Indexed for Emergency Audit)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="540" width="620" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e_state_telem_4" value="1 : N Parent Ref (homeId)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2B6CB0;strokeWidth=1.8;fontColor=#2C5282;fontSize=9;" edge="1" parent="1" source="col_gate_state_4" target="col_telemetry_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pol_event_4" value="1 : N Credential Validation (badgeId)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6B46C1;strokeWidth=1.8;fontColor=#44337A;fontSize=9;" edge="1" parent="1" source="col_policies_4" target="col_events_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_state_pol_4" value="1 : N Home Badges" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2B6CB0;strokeWidth=1.5;fontColor=#2C5282;fontSize=9;" edge="1" parent="1" source="col_gate_state_4" target="col_policies_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_event_alert_4" value="Repeated Denied Scans -> System Alert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C53030;strokeWidth=1.5;dashed=1;fontColor=#9B2C2C;fontSize=9;" edge="1" parent="1" source="col_events_4" target="col_alerts_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="callout_4" value="&lt;b&gt;DATA GOVERNANCE &amp; UK GDPR COMPLIANCE NOTE:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1A365D&quot;&gt;&lt;b&gt;1. Storage Limitation (Art. 5(1)(e)):&lt;/b&gt; Automated MongoDB TTL index on &lt;i&gt;telemetry_stream.timestamp&lt;/i&gt; expires records after 30 days (2,592,000s) to prevent unbounded disk growth.&lt;br&gt;&lt;b&gt;2. Data Minimisation (Art. 5(1)(c)):&lt;/b&gt; High-frequency telemetry retains zero personal identity; resident names are restricted to &lt;i&gt;access_policies&lt;/i&gt; with pseudonymized tokens.&lt;br&gt;&lt;b&gt;3. Index Performance:&lt;/b&gt; Compound B-Tree index &lt;i&gt;{ homeId: 1, timestamp: -1 }&lt;/i&gt; reduces recent telemetry query latency from 182.4ms (COLLSCAN) to &lt;b&gt;2.75ms (IXSCAN)&lt;/b&gt;.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2C5282;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="680" width="980" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- TAB 5: FIGURE 5 - SYSTEM PIPELINE ARCHITECTURE -->
  <diagram id="diag_system_pipeline" name="Fig 5 - End-to-End System Pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_5" value="&lt;b&gt;IoThings Smart Residential Gate Automation — End-to-End System Pipeline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#144178;strokeColor=#0D2B52;fontColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="940" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l1_box_5" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#CBD5E0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="80" width="940" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l1_lbl_5" value="&lt;b&gt;LAYER 1: PERCEPTION TIER (GATE HARDWARE SENSORS &amp; ACTUATORS)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#4A5568;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="135" y="85" width="450" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s1_5" value="&lt;b&gt;1. Active Optical Photocell&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;Infrared Safety Beam&lt;br&gt;Pin: &lt;b&gt;GPIO D4&lt;/b&gt; | 50ms Debounce&lt;br&gt;Detects Obstacles / Vehicles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2C5282;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="145" y="115" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2_5" value="&lt;b&gt;2. Mechanical Limit Switch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;Dual Contact Roller Microswitch&lt;br&gt;Pin: &lt;b&gt;GPIO D7&lt;/b&gt; (NC Fail-Safe)&lt;br&gt;States: CLOSED / OPEN / AJAR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2C5282;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="115" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3_5" value="&lt;b&gt;3. 13.56 MHz RFID Reader&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;Mifare Classic / DESFire Fobs&lt;br&gt;Protocol: &lt;b&gt;Wiegand-26&lt;/b&gt; to UART&lt;br&gt;Reads Resident &amp; Visitor Badges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2C5282;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="615" y="115" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4_5" value="&lt;b&gt;4. DC Actuator &amp; ACS712&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;12V Linear Screw Actuator&lt;br&gt;Current: ~3.8A to 4.2A&lt;br&gt;Stall &amp; Obstacle Detection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2C5282;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="115" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l2_box_5" value="&lt;b&gt;LAYER 2: TRANSPORT &amp; INGESTION TIER — Embedded Aedes MQTT Broker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#234E52&quot;&gt;&lt;b&gt;Port: 1883&lt;/b&gt; | TCP Keep-Alive: 60s | In-Memory Fast Event Pub/Sub&lt;br&gt;Topics: &lt;i&gt;iothings/home/{id}/gate/telemetry&lt;/i&gt; (QoS 0) &amp;nbsp;|&amp;nbsp; &lt;i&gt;iothings/home/{id}/gate/safety&lt;/i&gt; (QoS 1) &amp;nbsp;|&amp;nbsp; &lt;i&gt;iothings/home/{id}/gate/command&lt;/i&gt; (QoS 1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#319795;fontColor=#234E52;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="240" width="940" height="65" as="geometry" />
        </mxCell>
