<!-- Title Box -->
<mxCell id="title" value="&lt;b&gt;Smart Residential Gate Finite State Machine &amp; Safety Auto-Reverse Flow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#2A4365;fontColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1">
  <mxGeometry x="140" y="20" width="880" height="40" as="geometry" />
</mxCell>

<!-- State 1: FULLY_CLOSED -->
<mxCell id="st_closed" value="&lt;b&gt;FULLY_CLOSED&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Motor: Idle / Braked&lt;br&gt;Limit Switch: CLOSED&lt;br&gt;Photocell: Beam Clear&lt;br&gt;Gate Angle: 0°&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="160" y="150" width="180" height="90" as="geometry" />
</mxCell>

<!-- State 2: OPENING -->
<mxCell id="st_opening" value="&lt;b&gt;OPENING&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;Motor: Running Forward&lt;br&gt;Current: ~3.8 Amps&lt;br&gt;Limit Switch: AJAR&lt;br&gt;Safety: Active&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2C5282;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="500" y="150" width="180" height="90" as="geometry" />
</mxCell>

<!-- State 3: FULLY_OPEN -->
<mxCell id="st_open" value="&lt;b&gt;FULLY_OPEN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;Motor: Idle / Dwell&lt;br&gt;Limit Switch: OPEN&lt;br&gt;Inactivity Timer: 15s&lt;br&gt;Gate Angle: 90°&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="820" y="150" width="180" height="90" as="geometry" />
</mxCell>

<!-- State 4: CLOSING -->
<mxCell id="st_closing" value="&lt;b&gt;CLOSING&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7B341E&quot;&gt;Motor: Running Reverse&lt;br&gt;Current: ~4.1 Amps&lt;br&gt;Limit Switch: AJAR&lt;br&gt;Photocell: Monitoring&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="500" y="340" width="180" height="90" as="geometry" />
</mxCell>

<!-- Transitions -->
<!-- 1. Closed -> Opening -->
<mxCell id="tr_c_o" value="Valid RFID Badge Scan&#xa;/ Mobile App 'OPEN' Command" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2B6CB0;strokeWidth=2;fontColor=#2C5282;fontSize=10;" edge="1" parent="1" source="st_closed" target="st_opening">
  <mxGeometry relative="1" as="geometry" />
</mxCell>

<!-- 2. Opening -> Fully Open -->
<mxCell id="tr_o_fo" value="Hinge Microswitch:&#xa;Limit = FULLY_OPEN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F855A;strokeWidth=2;fontColor=#22543D;fontSize=10;" edge="1" parent="1" source="st_opening" target="st_open">
  <mxGeometry relative="1" as="geometry" />
</mxCell>

<!-- 3. Fully Open -> Closing -->
<mxCell id="tr_fo_c" value="15-Second Inactivity Dwell Elapsed&#xa;&amp; Beam Unbroken" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DD6B20;strokeWidth=2;fontColor=#7B341E;fontSize=10;" edge="1" parent="1" source="st_open" target="st_closing">
