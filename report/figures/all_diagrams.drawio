<mxCell id="b6" value="&lt;b&gt;12.92 ms&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#C53030;fontColor=#742A2A;verticalAlign=bottom;fontSize=10;spacingBottom=4;" vertex="1" parent="1">
