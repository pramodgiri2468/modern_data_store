<!-- Bar 3: Indexed Read (2.75 ms) -> 55px height -> y = 410 - 55 = 355 -->
<mxCell id="b3" value="&lt;b&gt;2.75 ms&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;verticalAlign=bottom;fontSize=10;spacingBottom=4;" vertex="1" parent="1">
