          <mxGeometry x="895" y="410" width="115" height="35" as="geometry" />
        </mxCell>

        <mxCell id="callout_7" value="&lt;b&gt;KEY EMPIRICAL TAKEAWAYS:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1A365D&quot;&gt;&lt;b&gt;1. Indexing Speedup (66x):&lt;/b&gt; Without index (COLLSCAN), fetching 50 telemetry points requires &lt;b&gt;182.40 ms&lt;/b&gt; scanning 5,000 documents. With compound index &lt;i&gt;{ homeId: 1, timestamp: -1 }&lt;/i&gt;, execution drops to &lt;b&gt;2.75 ms&lt;/b&gt; scanning exactly 50 index keys.&lt;br&gt;&lt;b&gt;2. Durability Cost (+11.31 ms):&lt;/b&gt; Memory-acknowledged write (&lt;i&gt;w: 1&lt;/i&gt;) completes in &lt;b&gt;1.30 ms&lt;/b&gt;, whereas quorum-journaled write (&lt;i&gt;w: &quot;majority&quot;&lt;/i&gt;) requires &lt;b&gt;12.61 ms&lt;/b&gt;. This 11.31 ms network round-trip guarantee eliminates dirty reads and guarantees zero data loss under abrupt node failure.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2C5282;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="460" width="940" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- TAB 8: FIGURE 8 - GATE SAFETY STATE MACHINE -->
  <diagram id="diag_gate_fsm" name="Fig 8 - Gate Safety State Machine">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title_8" value="&lt;b&gt;Smart Residential Gate Finite State Machine (FSM) &amp; Emergency Safety Auto-Reverse Logic&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#144178;strokeColor=#0D2B52;fontColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="940" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st_closed_8" value="&lt;b&gt;FULLY_CLOSED&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;&lt;b&gt;Motor:&lt;/b&gt; Idle / Electrically Braked&lt;br&gt;&lt;b&gt;Limit Switch:&lt;/b&gt; Pin D7 CLOSED&lt;br&gt;&lt;b&gt;Safety Beam:&lt;/b&gt; Clear (Monitoring)&lt;br&gt;&lt;b&gt;Gate Angle:&lt;/b&gt; 0&amp;deg; | Current: 0.0A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="120" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="st_opening_8" value="&lt;b&gt;OPENING&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;&lt;b&gt;Motor:&lt;/b&gt; Forward Drive Running&lt;br&gt;&lt;b&gt;Current Draw:&lt;/b&gt; ~3.82 Amps&lt;br&gt;&lt;b&gt;Limit Switch:&lt;/b&gt; AJAR (Pin D7 High)&lt;br&gt;&lt;b&gt;Travel Duration:&lt;/b&gt; ~8.5 seconds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2C5282;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="120" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="st_open_8" value="&lt;b&gt;FULLY_OPEN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;&lt;b&gt;Motor:&lt;/b&gt; Idle / Dwell State&lt;br&gt;&lt;b&gt;Limit Switch:&lt;/b&gt; Pin D7 OPEN Contact&lt;br&gt;&lt;b&gt;Dwell Timer:&lt;/b&gt; 15-Second Inactivity&lt;br&gt;&lt;b&gt;Gate Angle:&lt;/b&gt; 90&amp;deg; | Current: 0.0A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="120" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="st_closing_8" value="&lt;b&gt;CLOSING&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7B341E&quot;&gt;&lt;b&gt;Motor:&lt;/b&gt; Reverse Drive Running&lt;br&gt;&lt;b&gt;Current Draw:&lt;/b&gt; ~4.12 Amps&lt;br&gt;&lt;b&gt;Limit Switch:&lt;/b&gt; AJAR (Travel Active)&lt;br&gt;&lt;b&gt;Photocell:&lt;/b&gt; High-Frequency Active Scan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=10;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="320" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tr_c_o_8" value="Valid RFID Scan (Mifare)&#xa;or Mobile REST /api/gate/open" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2B6CB0;strokeWidth=2;fontColor=#2C5282;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="st_closed_8" target="st_opening_8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_o_fo_8" value="Microswitch Contact:&#xa;Limit = FULLY_OPEN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2F855A;strokeWidth=2;fontColor=#22543D;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="st_opening_8" target="st_open_8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr_fo_c_8" value="15s Inactivity Timer Expired&#xa;&amp; Safety Beam Unbroken" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DD6B20;strokeWidth=2;fontColor=#7B341E;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="st_open_8" target="st_closing_8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="930" y="367" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tr_c_fc_8" value="Microswitch Contact:&#xa;Limit = FULLY_CLOSED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2F855A;strokeWidth=2;fontColor=#22543D;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="st_closing_8" target="st_closed_8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="250" y="367" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="tr_safety_8" value="&lt;b&gt;EMERGENCY SAFETY INTERLOCK (BS EN 12453)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Infrared Beam BLOCKED by Obstacle / Vehicle / Child&lt;/b&gt;&lt;br&gt;Immediate H-Bridge Motor Reverse Dispatched in &lt;b&gt;&amp;lt; 7.4 ms&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=1;strokeColor=#C53030;strokeWidth=3.5;fontColor=#C53030;fontSize=10;labelBackgroundColor=#FFF5F5;" edge="1" parent="1" source="st_closing_8" target="st_open_8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="270" />
              <mxPoint x="790" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="safety_event_box_8" value="&lt;b&gt;SAFETY EVENT TELEMETRY DISPATCH:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9B2C2C&quot;&gt;1. Intercepted on MQTT topic: &lt;i&gt;iothings/home/{id}/gate/safety&lt;/i&gt;&lt;br&gt;2. Controller halts motor within &lt;b&gt;7.4 ms&lt;/b&gt; (bypasses database queue)&lt;br&gt;3. Appends critical alert document to &lt;i&gt;system_alerts&lt;/i&gt; collection&lt;br&gt;4. Asynchronously dispatches SMTP security email to &lt;b&gt;pg016742@gmail.com&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#FEB2B2;fontColor=#9B2C2C;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="140" y="235" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="callout_8" value="&lt;b&gt;BRITISH &amp; EUROPEAN SAFETY STANDARD BS EN 12453:2017 MANDATE:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1A365D&quot;&gt;Motorized residential gates must prevent crush, shear, and impact injuries. The standard mandates maximum dynamic impact force &amp;le; 400 N and obstacle release time &amp;le; 750 ms. The IoThings optical photocell hardware debounce (50 ms) coupled with the Node.js sub-8ms safety interlock (measured at &lt;b&gt;7.4 ms&lt;/b&gt;) delivers 100x safety margin, immediately reverting closing gates to full open upon any obstruction.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2C5282;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="445" width="940" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>