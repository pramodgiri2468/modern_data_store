  <mxGeometry x="875" y="420" width="100" height="40" as="geometry" />
</mxCell>

<!-- Callout Note -->
<mxCell id="bench_note" value="&lt;b&gt;KEY BENCHMARK TAKEAWAYS:&lt;/b&gt; Majority quorum introduces an 11.31 ms network coordination penalty over single-node writes, but guarantees zero data loss across node failovers. Compound index { homeId: 1, timestamp: -1 } reduces point read latency to 2.75 ms (a 66-fold improvement over COLLSCAN)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2C5282;fontSize=10;align=center;" vertex="1" parent="1">
  <mxGeometry x="140" y="495" width="880" height="45" as="geometry" />
</mxCell>
</root>
