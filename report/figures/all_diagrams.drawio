      <mxPoint x="660" y="270" />
      <mxPoint x="820" y="270" />
    </Array>
  </mxGeometry>
</mxCell>

<mxCell id="e_hb23" value="Heartbeat Gossip (2s Interval) &amp; Term Voting" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DD6B20;strokeWidth=1.5;dashed=1;fontColor=#7B341E;fontSize=10;" edge="1" parent="1" source="n2" target="n3">
  <mxGeometry relative="1" as="geometry" />
</mxCell>

<!-- Bottom Quorum Explanation Box -->
<mxCell id="q_box" value="&lt;b&gt;DISTRIBUTED CONSENSUS &amp; QUORUM MATHEMATICS:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1A365D&quot;&gt;&lt;b&gt;Total Cluster Members (N) = 3&lt;/b&gt; &amp;nbsp;|&amp;nbsp; &lt;b&gt;Majority Quorum (Q) = floor(N/2) + 1 = floor(3/2) + 1 = 2 Votes Required&lt;/b&gt;&lt;br&gt;&lt;b&gt;Failover Mechanics:&lt;/b&gt; If Node 1 experiences hardware fault, Node 2 &amp; Node 3 detect missing heartbeat (timeout: 10s), elect Node 2 as Primary in &lt;b&gt;1.84 seconds&lt;/b&gt;.&lt;br&gt;&lt;b&gt;Durability Guarantee:&lt;/b&gt; Writes acknowledged under &lt;b&gt;{ w: 'majority', j: true }&lt;/b&gt; guarantee ZERO data loss across partitions and node terminations.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2C5282;fontSize=11;align=center;" vertex="1" parent="1">
  <mxGeometry x="180" y="510" width="800" height="85" as="geometry" />
</mxCell>
</root>
