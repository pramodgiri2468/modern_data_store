          <mxGeometry x="410" y="245" width="200" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cfg_replica_box_1" value="&lt;b&gt;Config Server Replica Set (cfgRS)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7B341E&quot;&gt;3-Node Quorum Consensus | 2s Heartbeats&lt;br&gt;&lt;b&gt;Ports:&lt;/b&gt; 27019, 27020, 27021&lt;br&gt;&lt;b&gt;Catalog:&lt;/b&gt; Chunk Ranges, Routing Tables &amp; Shard Map&lt;br&gt;&lt;b&gt;Durability:&lt;/b&gt; Read/Write Majority WiredTiger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=10;" vertex="1" parent="1">
