  <mxGeometry x="360" y="196" width="90" height="214" as="geometry" />
</mxCell>
<mxCell id="lbl_b2" value="&lt;b&gt;POST Create&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#718096&quot;&gt;Schema Validated&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
