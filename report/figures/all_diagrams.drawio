</mxCell>
<mxCell id="lbl_b3" value="&lt;b&gt;GET Read&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#718096&quot;&gt;IXSCAN Index&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=top;fontSize=10;" vertex="1" parent="1">
