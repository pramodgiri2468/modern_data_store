<mxCell id="e_hb13" value="2000ms Heartbeats&#xa;&amp; Oplog Replication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F855A;strokeWidth=2;fontColor=#22543D;fontSize=10;" edge="1" parent="1" source="n1" target="n3">
