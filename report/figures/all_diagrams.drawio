<mxCell id="b5" value="&lt;b&gt;8.71 ms&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#6B46C1;fontColor=#44337A;verticalAlign=bottom;fontSize=10;spacingBottom=4;" vertex="1" parent="1">
