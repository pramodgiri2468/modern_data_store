  <mxGeometry relative="1" as="geometry" />
</mxCell>

<mxCell id="rel_drawbacks" value="&lt;b&gt;Bottlenecks:&lt;/b&gt; Requires 3-table SQL JOIN to read state; DDL schema lock on new sensor; multiple random disk seeks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FED7D7;strokeColor=#FEB2B2;fontColor=#742A2A;fontSize=9;align=center;" vertex="1" parent="1">
  <mxGeometry x="160" y="470" width="380" height="50" as="geometry" />
</mxCell>

<!-- Right Container: MongoDB Document -->
<mxCell id="c_mongo" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF4;strokeColor=#9AE6B4;dashed=1;" vertex="1" parent="1">
  <mxGeometry x="600" y="80" width="420" height="460" as="geometry" />
</mxCell>
<mxCell id="lbl_mongo" value="&lt;b&gt;MONGODB EMBEDDED DOCUMENT MODEL&lt;/b&gt;&lt;br&gt;&lt;font color=#22543D&gt;Pre-Aggregated BSON Tree • Single Disk Seek • Zero JOINs&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#22543D;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="610" y="90" width="400" height="30" as="geometry" />
</mxCell>

<mxCell id="doc_json" value="&lt;b&gt;Collection: gate_telemetries&lt;/b&gt;&lt;hr&gt;{&#xa;  &quot;_id&quot;: ObjectId(&quot;6709a1f2b4...&quot;),&#xa;  &quot;homeId&quot;: &quot;HOME_UK_001&quot;,&#xa;  &quot;timestamp&quot;: ISODate(&quot;2026-10-02T08:14:22Z&quot;),&#xa;  &quot;gateState&quot;: &quot;CLOSING&quot;,&#xa;  &quot;sensors&quot;: {&#xa;    &quot;photocell&quot;: { &quot;status&quot;: &quot;CLEAR&quot;, &quot;beamStrength&quot;: 98.4 },&#xa;    &quot;limitSwitch&quot;: { &quot;state&quot;: &quot;AJAR&quot;, &quot;angleDeg&quot;: 34.2 },&#xa;    &quot;rfid&quot;: { &quot;lastScannedBadge&quot;: &quot;TAG_AUTH_8831&quot; }&#xa;  },&#xa;  &quot;metrics&quot;: {&#xa;    &quot;motorCurrentAmps&quot;: 4.12,&#xa;    &quot;batteryVoltage&quot;: 13.8&#xa;  }&#xa;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F855A;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
  <mxGeometry x="620" y="130" width="380" height="320" as="geometry" />
</mxCell>

<mxCell id="mongo_advantages" value="&lt;b&gt;Advantages:&lt;/b&gt; Zero JOINs; fetched in 1 contiguous disk seek (2.75ms); dynamic schema polymorphism; native JSON mapping." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6F6D5;strokeColor=#9AE6B4;fontColor=#22543D;fontSize=9;align=center;" vertex="1" parent="1">
  <mxGeometry x="620" y="470" width="380" height="50" as="geometry" />
</mxCell>

      </root>
