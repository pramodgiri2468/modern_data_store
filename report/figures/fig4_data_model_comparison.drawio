<!-- Title Box -->
<mxCell id="title" value="&lt;b&gt;Data Modeling Paradigm: Relational 3NF Schema vs. MongoDB Embedded Document Model&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A365D;strokeColor=#2A4365;fontColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1">
  <mxGeometry x="140" y="20" width="880" height="40" as="geometry" />
</mxCell>

<!-- Left Container: Relational 3NF -->
<mxCell id="c_rel" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#FEB2B2;dashed=1;" vertex="1" parent="1">
  <mxGeometry x="140" y="80" width="420" height="460" as="geometry" />
</mxCell>
<mxCell id="lbl_rel" value="&lt;b&gt;RELATIONAL 3NF SCHEMA (POSTGRESQL)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9B2C2C&quot;&gt;Normalized Tables • Multi-Table SQL JOINs • Schema-on-Write&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#9B2C2C;fontSize=11;" vertex="1" parent="1">
  <mxGeometry x="150" y="90" width="400" height="30" as="geometry" />
</mxCell>

<mxCell id="t_homes" value="&lt;b&gt;gate_homes&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; home_id : VARCHAR(32)&lt;br&gt;owner_name : VARCHAR(128)&lt;br&gt;address_postcode : VARCHAR(16)&lt;br&gt;created_at : TIMESTAMP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E53E3E;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
  <mxGeometry x="160" y="130" width="220" height="80" as="geometry" />
</mxCell>

<mxCell id="t_devices" value="&lt;b&gt;gate_devices&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; device_id : VARCHAR(32)&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; home_id : VARCHAR(32)&lt;br&gt;device_type : VARCHAR(64)&lt;br&gt;firmware_version : VARCHAR(16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E53E3E;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
  <mxGeometry x="160" y="240" width="220" height="80" as="geometry" />
</mxCell>

<mxCell id="t_telemetry" value="&lt;b&gt;gate_telemetry_events&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; event_id : BIGSERIAL&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; device_id : VARCHAR(32)&lt;br&gt;timestamp : TIMESTAMP&lt;br&gt;photocell_status : VARCHAR(16)&lt;br&gt;limit_switch : VARCHAR(16)&lt;br&gt;motor_current_amps : NUMERIC(4,2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E53E3E;fontColor=#2D3748;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
  <mxGeometry x="160" y="350" width="220" height="105" as="geometry" />
</mxCell>

