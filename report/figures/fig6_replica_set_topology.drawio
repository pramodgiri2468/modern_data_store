<mxfile host="app.diagrams.net" modified="2026-10-04T00:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="diag_replica_topology" name="Figure 6 - 3-Node Replica Set rs0">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Box -->
        <mxCell id="title" value="&lt;b&gt;MongoDB 3-Node Replica Set Topology &amp; Quorum Consensus Architecture (rs0)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#144178;strokeColor=#0D2B52;fontColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="140" y="20" width="880" height="40" as="geometry" />
        </mxCell>

        <!-- Node.js Client Box (Top Left) -->
        <mxCell id="client_box" value="&lt;b&gt;Node.js Express Driver&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2C5282&quot;&gt;Connection String:&lt;br&gt;&lt;i&gt;mongodb://127.0.0.1:27017,27018,27019/?replicaSet=rs0&lt;/i&gt;&lt;br&gt;Write Concern: &lt;b&gt;{ w: 'majority', j: true }&lt;/b&gt;&lt;br&gt;Read Preference: &lt;b&gt;primaryPreferred&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#2B6CB0;fontColor=#2C5282;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="140" y="85" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- Primary Node (Top Center/Right) -->
        <mxCell id="n1" value="&lt;b&gt;NODE 1: PRIMARY&lt;/b&gt;&lt;br&gt;&lt;b&gt;127.0.0.1:27017&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22543D&quot;&gt;&lt;b&gt;Priority: 2&lt;/b&gt; | Voting Shares: 1&lt;br&gt;Data Path: /data/db1&lt;br&gt;Directs Client Read/Writes&lt;br&gt;Appends to &lt;b&gt;local.oplog.rs&lt;/b&gt;&lt;br&gt;WiredTiger Cache: 1.5 GB&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#F0FFF4;strokeColor=#2F855A;fontColor=#22543D;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="260" height="150" as="geometry" />
        </mxCell>

        <!-- Arrow Client -> Primary -->
        <mxCell id="e_client_pri" value="Client Writes {w: 'majority'}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2F855A;strokeWidth=2;fontColor=#22543D;fontSize=9;" edge="1" parent="1" source="client_box" target="n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Secondary Node 1 (Bottom Left) -->
        <mxCell id="n2" value="&lt;b&gt;NODE 2: SECONDARY&lt;/b&gt;&lt;br&gt;&lt;b&gt;127.0.0.1:27018&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7B341E&quot;&gt;&lt;b&gt;Priority: 1&lt;/b&gt; | Voting Shares: 1&lt;br&gt;Data Path: /data/db2&lt;br&gt;Tails Primary &lt;b&gt;local.oplog.rs&lt;/b&gt;&lt;br&gt;Dynamic Ping Sync Source&lt;br&gt;Eligible for Primary Election&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="310" width="250" height="150" as="geometry" />
        </mxCell>

        <!-- Secondary Node 2 (Bottom Right) -->
        <mxCell id="n3" value="&lt;b&gt;NODE 3: SECONDARY&lt;/b&gt;&lt;br&gt;&lt;b&gt;127.0.0.1:27019&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7B341E&quot;&gt;&lt;b&gt;Priority: 1&lt;/b&gt; | Voting Shares: 1&lt;br&gt;Data Path: /data/db3&lt;br&gt;Tails Primary &lt;b&gt;local.oplog.rs&lt;/b&gt;&lt;br&gt;Dynamic Ping Sync Source&lt;br&gt;Quorum Voter Member&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFAF0;strokeColor=#DD6B20;fontColor=#7B341E;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="310" width="250" height="150" as="geometry" />
        </mxCell>

        <!-- Heartbeat & Sync Connectors -->
        <mxCell id="e_hb12" value="2000ms Heartbeats&#xa;&amp; Asynchronous Oplog Sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F855A;strokeWidth=2;fontColor=#22543D;fontSize=9;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="260" />
              <mxPoint x="345" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_hb13" value="2000ms Heartbeats&#xa;&amp; Asynchronous Oplog Sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F855A;strokeWidth=2;fontColor=#22543D;fontSize=9;" edge="1" parent="1" source="n1" target="n3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="750" y="260" />
              <mxPoint x="815" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="e_hb23" value="Peer Heartbeat Gossip (2000ms Interval) &amp; Term Voting" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DD6B20;strokeWidth=1.5;dashed=1;fontColor=#7B341E;fontSize=9;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Empirical Failover Timeline Box (Right side) -->
        <mxCell id="failover_box" value="&lt;b&gt;EMPIRICAL FAILOVER BENCHMARK (Primary Killed at T=0):&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#9B2C2C&quot;&gt;&lt;b&gt;T = 0.00s:&lt;/b&gt; SIGKILL dispatched to mongod on :27017&lt;br&gt;&lt;b&gt;T = 1.42s:&lt;/b&gt; Secondaries detect missed heartbeat threshold&lt;br&gt;&lt;b&gt;T = 1.65s:&lt;/b&gt; Node 2 initiates election; Node 3 casts vote (Quorum: 2/2)&lt;br&gt;&lt;b&gt;T = 1.84s:&lt;/b&gt; &lt;b&gt;Node 2 promoted to PRIMARY&lt;/b&gt;; client resumes writes&lt;br&gt;&lt;b&gt;Total Disruption:&lt;/b&gt; 1.84 seconds | Data Lost: &lt;b&gt;0 bytes&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5F5;strokeColor=#FEB2B2;fontColor=#9B2C2C;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="85" width="200" height="140" as="geometry" />
        </mxCell>

        <!-- Bottom Quorum Explanation Box -->
        <mxCell id="q_box" value="&lt;b&gt;DISTRIBUTED CONSENSUS &amp; QUORUM MATHEMATICS:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1A365D&quot;&gt;&lt;b&gt;Total Cluster Members (N) = 3&lt;/b&gt; &amp;nbsp;|&amp;nbsp; &lt;b&gt;Majority Quorum Requirement (Q) = &amp;lfloor;N/2&amp;rfloor; + 1 = &amp;lfloor;3/2&amp;rfloor; + 1 = 2 of 3 Votes Required&lt;/b&gt;&lt;br&gt;&lt;b&gt;Split-Brain Prevention:&lt;/b&gt; If network partitions isolate any single node, it cannot reach Q=2 votes and automatically steps down to Secondary.&lt;br&gt;&lt;b&gt;Durability Guarantee:&lt;/b&gt; Writes acknowledged under &lt;b&gt;{ w: 'majority', j: true }&lt;/b&gt; persist to on-disk journals of a quorum before returning success to the driver, guaranteeing zero rollback.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontColor=#2C5282;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="140" y="490" width="880" height="75" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
